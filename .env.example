# If DATABASE_URL is exported in your shell, it wins over POSTGRES_* (unset it if you see user "USER").
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

BILLETTO_API_KEYPAIR=your_key:your_secret
BILLETTO_API_BASE_URL=https://billetto.dk
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_SIGN_IN_URL=https://YOUR_INSTANCE.accounts.dev/sign-in
CLERK_SIGN_UP_URL=https://YOUR_INSTANCE.accounts.dev/sign-up
CLERK_SIGN_OUT_URL=https://YOUR_INSTANCE.accounts.dev/sign-in
